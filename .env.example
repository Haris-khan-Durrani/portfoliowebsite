# =============================================================================
# MySQL Database Configuration (Blog SEO / AEO / GEO Engine)
# =============================================================================
# Provide either DATABASE_URL or individual MYSQL_* variables.
# When MySQL is reachable, the app automatically creates `blog_posts` and
# `blog_media` tables and seeds initial articles.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hkd_portfolio

# Optional: Single connection string alternative
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/hkd_portfolio

# =============================================================================
# Admin Authentication (/blog/login & /blog/admin)
# =============================================================================
ADMIN_EMAIL=haris.khan5117@gmail.com
ADMIN_USERNAME=haris
ADMIN_PASSWORD=HKD-Architect-2026!
ADMIN_SESSION_SECRET=hkd-portfolio-hmac-secret-2026-dubai

# Optional: Google Search Console verification code
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-gsc-token

# Optional: Contact form webhook forwarding (n8n / GoHighLevel / Slack)
# CONTACT_WEBHOOK_URL=https://your-webhook-endpoint
